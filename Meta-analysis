         effect_id = paste0(study_id,"_", row_number()),
         contrast  = factor(contrast, levels=c("HC_vs_MDD","After_vs_Before")),
         cytokine  = factor(cytokine),
         group     = factor(group, levels=c("TH1","TH2","Others")))

fit_by <- function(df){
  m <- metafor::rma.mv(yi, vi, random = ~1|study_id/effect_id, data=df, method="REML")
  tab <- clubSandwich::coef_test(m, vcov="CR2", cluster=df$study_id)
  data.frame(SMD = m$b[1,1],
             SE  = sqrt(m$vb[1,1]),
             LCL = m$b[1,1] - 1.96*sqrt(m$vb[1,1]),
             UCL = m$b[1,1] + 1.96*sqrt(m$vb[1,1]),
             p   = tab$p_Satt[1],
             tau2 = sum(m$sigma2),
             I2   = 100 * (sum(m$sigma2)/(sum(m$sigma2)+mean(df$vi))),
             k    = nrow(df))
}
summ_ck <- es_all %>%
  group_by(contrast, group, cytokine) %>%
  group_modify(~fit_by(.x)) %>%
  ungroup() %>%
  arrange(contrast, group, cytokine)

fmt_p <- function(p) ifelse(is.na(p),"", ifelse(p<0.001,"<0.001", ifelse(p<0.01,"<0.01", sprintf("%.4f",p))))
tab_pretty <- summ_ck %>%
  mutate(Contrast = ifelse(contrast=="HC_vs_MDD","MDD × HC","After × Before"),
         `SMD (Std. Mean Difference)` = round(SMD,2),
         `95% CI (Lower)` = round(LCL,2),
         `95% CI (Upper)` = round(UCL,2),
         `P-value` = fmt_p(p),
         `Heterogeneity I² (%)` = paste0(round(pmax(0,pmin(100,I2)),0),"%")) %>%
  select(Contrast, Group=group, Cytokines=cytokine,
         `SMD (Std. Mean Difference)`,`95% CI (Lower)`,`95% CI (Upper)`,
         `P-value`,`Heterogeneity I² (%)`, k, tau2)
writexl::write_xlsx(list(
  "Summary_by_group" = tab_pretty,
  "Raw" = summ_ck
), file.path(output_dir, "meta_multilevel_summary.xlsx"))

## Orchard plot 
orchard_one <- function(df, title=""){
  if(nrow(df)<2) return(NULL)
  m <- metafor::rma.mv(yi, vi, random=~1|study_id/effect_id, data=df, method="REML")
  orchard::orchard_plot(m, xlab="Hedges' g (SMD)", transfm=FALSE) + ggtitle(title)
}

save_orchard_page <- function(data, the_group, the_contrast, file_pdf,
                              ncol=2, width=10, height=8){
  sub <- data %>% filter(group==the_group, contrast==the_contrast)
  if(nrow(sub)==0){ message("Sem dados para ", the_group," / ", the_contrast); return(invisible(NULL)) }
  plots <- lapply(levels(sub$cytokine), function(ck){
    df <- sub %>% filter(cytokine==ck)
    if(nrow(df)<2) return(NULL)
    ttl <- paste0(as.character(ck), " — ",
                  ifelse(the_contrast=="HC_vs_MDD","MDD vs HC","After vs Before"))
    orchard_one(df, ttl)
  })
  plots <- Filter(Negate(is.null), plots)
  if(length(plots)==0){ message("Sem plots válidos para ", the_group," / ", the_contrast); return(invisible(NULL)) }
  nrow_grid <- ceiling(length(plots)/ncol)
  page <- Reduce(`+`, plots) + patchwork::plot_layout(ncol=ncol, nrow=nrow_grid)
  ggsave(file_pdf, plot=page, width=width, height=height, device=cairo_pdf)
}

