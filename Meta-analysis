orchard_like_plot <- function(m, title = NULL) {
  if (is.null(title)) title <- attr(m, "title")
  df <- data.frame(
    study = m$studlab,
    TE    = m$TE,
    se    = m$seTE
  )
  df$w_iv <- 1 / (df$se^2)
  df$low  <- df$TE - 1.96 * df$se
  df$high <- df$TE + 1.96 * df$se
  df$study <- factor(df$study, levels = df$study[order(df$TE, decreasing = TRUE)])
  
  pe <- m$TE.random; lo <- m$lower.random; hi <- m$upper.random
  pooled_row <- data.frame(
    study = "(pooled)", TE = pe, se = NA_real_,
    w_iv  = max(df$w_iv, na.rm = TRUE), low = lo, high = hi
  )
  dfp <- rbind(pooled_row, df)
  dfp$study <- factor(dfp$study, levels = c("(pooled)", levels(df$study)))
  
  ggplot(dfp, aes(x = TE, y = study)) +
    geom_vline(xintercept = 0, linetype = "dashed", linewidth = 0.4) +
    geom_errorbarh(data = subset(dfp, study != "(pooled)"),
                   aes(xmin = low, xmax = high), height = 0.15) +
    geom_point(data = subset(dfp, study != "(pooled)"),
               aes(size = w_iv), shape = 16) +
    geom_errorbarh(data = subset(dfp, study == "(pooled)"),
                   aes(xmin = low, xmax = high), height = 0.25, linewidth = 1) +
    geom_point(data = subset(dfp, study == "(pooled)"),
               shape = 23, fill = "black", color = "black", size = 3) +
    scale_size(range = c(1.5, 5), guide = "none") +
    labs(
      title = title,
      x = paste0(m$sm, " (Hedges g)"),
      y = NULL,
      subtitle = sprintf("Random-effects: g = %.2f (95%% CI %.2f to %.2f); I² = %d%%",
                         pe, lo, hi, round(m$I2))
    ) +
    theme_bw(base_size = 10) +
    theme(plot.title.position = "plot",
          plot.title = element_text(face = "bold"),
          panel.grid.major.y = element_blank())
}

save_orchard_page <- function(meta_list, titles = NULL,
                              outfile = "orchard_page.pdf",
                              ncol = 2, width = 10, height = 6,
                              device = "pdf", dpi = 300) {
  stopifnot(is.list(meta_list))
  if (!is.null(titles) && length(titles) != length(meta_list)) {
    stop("`titles` length must match `meta_list`.")
  }
  

  outdir <- dirname(outfile)
  if (!dir.exists(outdir)) dir.create(outdir, recursive = TRUE, showWarnings = FALSE)
  
  plots <- Map(function(m, t) orchard_like_plot(m, t), meta_list, titles)
  pg <- wrap_plots(plots, ncol = ncol)
  
  ok <- tryCatch({
    ggsave(filename = outfile, plot = pg,
           width = width, height = height, units = "in",
           device = device, dpi = dpi, limitsize = FALSE)
    TRUE
  }, error = function(e) {
    message("ggsave() failed: ", conditionMessage(e))
    FALSE
  })
  
  if (ok && file.exists(outfile)) {
    message("Saved: ", normalizePath(outfile))
  } else {
    message("Failed to save file: ", outfile,
            "\nTips: (1) use device='pdf'; (2) check write permissions; ",
            "(3) avoid `cairo_pdf` unless Cairo is installed.")
  }
}


