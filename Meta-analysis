# ==============================================================================
# Meta-analysis (package meta) 
# ==============================================================================

# Heterogeneity estimator: DerSimonian–Laird (DL), classical confidence interval, 
# and effect size = SMD (Hedges' g).
#
# Interpretation:
# SMD > 0 indicates that the “experimental” group ("MDD" or “After”) presents 
# higher cytokine levels than the control group ("HC" or "Before").
# SMD < 0 indicates lower levels.
#
# Labels (MDD vs HC; After vs Before),
# Q, I², τ², z/p-value of the pooled effect,
# study columns, means, SDs, sample sizes, weight, and SMD with 95% CI.
#
# Analyses stratified by cytokine profile groups:
# TH1 (IFN-γ, IL-2),
# TH2 (IL-4, IL-5, IL-10, IL-13), and
# Others (TNF-α, IL-1β, IL-6, IL-8) were performed for both MDD × HC and AFTER × BEFORE comparisons.

# ==============================================================================
# Forest plots
# ==============================================================================

# Group 1: MDD vs HC
settings.meta(
  common = FALSE, random = TRUE,
  method.tau = "DL", method.random.ci = "classic",
  sm = "SMD"
)

mk_meta <- function(xlsx, sheet, title){
  df <- read_excel(xlsx, sheet = sheet)
  m <- metacont(
    n.e = ne, mean.e = me, sd.e = sde,
    n.c = nc, mean.c = mc, sd.c = sdc,
    studlab = estudo,
    data = df,
    sm = "SMD", method.smd = "Hedges",
    common = FALSE, random = TRUE, method.tau = "DL"
  )
  attr(m, "title") <- title
  m
}

fgrob_block <- function(m, xlim_common = c(-20, 20), title_indent = 0.20) {
  ttl <- attr(m, "title"); if (is.null(ttl)) ttl <- ""
  g <- grid.grabExpr(
    forest(
      m,
      label.e = "MDD", label.c = "HC",
      test.overall = TRUE,        # Z e P por bloco
      print.tau2   = TRUE,        # Tau²
      print.pval.Q = TRUE,        # Chi² (Q) e p
      print.I2     = TRUE,        # I²
      
      # Layout estilo RevMan
      leftcols  = c("studlab","mean.e","sd.e","n.e","mean.c","sd.c","n.c"),
      leftlabs  = c("Study","Mean","SD","Total","Mean","SD","Total"),
      rightcols = c("w.random","effect","ci"),
      rightlabs = c("Weight (%)","Std. Mean Difference","IV, Random, 95% CI"),
      
      col.square = "black",
      col.diamond = "black",
      col.diamond.lines = "black",
      xlab = "",
      xlim = xlim_common          # << escala fixa ±20
    )
  )
  title_grob <- textGrob(
    ttl,
    gp = gpar(fontface = "bold", cex = 1.0),
    x  = unit(title_indent, "npc"), just = "left"   # "na esquerda, mas não muito"
  )
  arrangeGrob(title_grob, g, heights = c(0.08, 0.92))
}

make_page <- function(xlsx_file, sheet_title_pairs, outfile,
                      title_indent = 0.20,
                      page_width = 20, page_height = 6,
                      xlim_override = c(-20, 20)) {
  
  metas <- lapply(sheet_title_pairs, function(st) mk_meta(xlsx_file, st$sheet, st$title))
  grobs <- lapply(metas, function(m) fgrob_block(m, xlim_common = xlim_override, title_indent = title_indent))
  
  pdf(outfile, width = page_width, height = page_height)
  do.call(grid.arrange, c(grobs, ncol = 1, list(heights = rep(1/length(grobs), length(grobs)))))
  dev.off()
}

