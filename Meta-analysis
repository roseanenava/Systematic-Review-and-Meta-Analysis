# Summary tables (Effect + I² + p + Egger)

.safe_egger <- function(m) {
  k <- sum(is.finite(m$TE))
  if (k < 3) return(NA_real_)
  out <- suppressWarnings(tryCatch(metabias(m, method.bias = "linreg", k.min = 3), error = function(e) NULL))
  if (is.null(out) || is.null(out$p.value)) return(NA_real_)
  pv <- suppressWarnings(as.numeric(out$p.value[1]))
  if (!is.finite(pv)) NA_real_ else pv
}

.build_metas <- function(xlsx_file, sheet_title_pairs) {
  ms <- lapply(sheet_title_pairs, function(st) {
    m <- tryCatch(mk_meta(xlsx_file, st$sheet, st$title), error = function(e) NULL)
    if (!is.null(m)) attr(m, "title") <- st$title
    m
  })
  Filter(Negate(is.null), ms)
}

.fmt_p <- function(p) {
  ifelse(is.na(p), "",
         ifelse(p < 0.001, "<0.001",
                ifelse(p < 0.01, "<0.01", sprintf("%.4f", p))))
}

.extract_summary <- function(m) {
  data.frame(
    Cytokines = enc2utf8(ifelse(is.null(attr(m, "title")), "", attr(m, "title"))),
    Effect    = unname(m$TE.random),
    CI_lower  = unname(m$lower.random),
    CI_upper  = unname(m$upper.random),
    I2        = unname(m$I2),                 # já em 0–100
    p_value   = unname(m$pval.random),
    p_egger   = .safe_egger(m),
    sm        = m$sm,                         # "SMD" ou "MD" (para conferência)
    stringsAsFactors = FALSE
  )
}

make_table_from_metas <- function(metas, digits = 2) {
  tab <- do.call(rbind, lapply(metas, .extract_summary))
  tab <- tab[order(tab$Cytokines), ]
  
  eff_label <- ifelse(any(tab$sm == "MD"), "MD (Mean Difference)", "SMD (Std. Mean Difference)")
  p <- data.frame(
    Cytokines = tab$Cytokines,
    check.names = FALSE
  )
  p[[eff_label]]        <- round(tab$Effect, digits)
  p[["95% CI (Lower)"]] <- round(tab$CI_lower, digits)
  p[["95% CI (Upper)"]] <- round(tab$CI_upper, digits)
  
  i2_vals <- tab$I2
  if (is.finite(max(i2_vals, na.rm = TRUE)) && max(i2_vals, na.rm = TRUE) <= 1) i2_vals <- 100*i2_vals
  p[["Heterogeneity I² (%)"]] <- ifelse(is.na(i2_vals), "", sprintf("%d%%", round(i2_vals, 0)))
  
  p[["P-value"]]              <- .fmt_p(tab$p_value)
  p[["P-value Egger’s test"]] <- ifelse(is.na(tab$p_egger), "*", .fmt_p(tab$p_egger))
  
  list(raw = tab, p = p)
}

