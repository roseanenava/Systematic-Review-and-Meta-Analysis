extract_affiliation_data <- function(xml_doc) {
  
  articles <- xml_find_all(xml_doc, "//PubmedArticle")
  
  map_dfr(articles, function(article) {
    
    pmid <- xml_text(xml_find_first(article, ".//PMID"))
    title <- xml_text(xml_find_first(article, ".//ArticleTitle"))
    
   
    affiliation <- xml_text(xml_find_first(article, ".//AffiliationInfo/Affiliation"))
    
    tibble(
      PMID = pmid,
      Title = title,
      affiliation = affiliation
    )
  })
}

