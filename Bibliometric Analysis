detect_country_from_affiliation <- function(x) {
  if (is.na(x) || x == "") return(NA_character_)
  
  x_low <- str_to_lower(x)
  
  hits <- country_list[
    sapply(country_list, function(cty) {
      str_detect(x_low, fixed(str_to_lower(cty)))
    })
  ]
  
  if (length(hits) == 0) return(NA_character_)
  
  hits[length(hits)]
}

