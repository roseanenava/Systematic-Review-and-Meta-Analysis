safe_pubmed_count <- function(query) {
  tryCatch(
    rentrez::entrez_search(db = "pubmed", term = query, retmax = 0)$count,
    error = function(e) {
      message("PubMed query failed: ", query)
      NA_real_
    }
  )
}

build_yearly_queries <- function(terms, years) {
  tibble(year = years) |>
    tidyr::crossing(term = names(terms)) |>
    mutate(query = glue("{terms[term]} AND {year}[PDAT]"))
}

count_yearly_pubmed <- function(terms, years) {
  build_yearly_queries(terms, years) |>
    mutate(count = map_dbl(query, safe_pubmed_count)) |>
    select(year, term, count) |>
    pivot_wider(names_from = term, values_from = count)
}


save_tiff <- function(filename, width, height, res = 300, compression = "lzw", plot_expr) {
  tiff(
    file.path(figs_dir, filename),
    units = "in",
    width = width,
    height = height,
    res = res,
    compression = compression
  )
  on.exit(dev.off(), add = TRUE)
  force(plot_expr)
}

create_small_trend_plot <- function(data, term, color) {
  plot_data <- data |> filter(name == term)
  
  ggplot(plot_data, aes(year, value, group = name)) +
    geom_line(linewidth = 0.3, colour = color) +
    geom_point(
      aes(size = value),
      shape = 21,
      colour = "black",
      fill = color
    ) +
    facet_wrap(~name, scales = "free_y") +
    theme_minimal(base_size = 30) +
    ylab("N. articles") +
    xlab(NULL) +
    theme(
      axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
      axis.title.x = element_text(size = 25),
      axis.title.y = element_text(size = 25),
      legend.position = "none"
    )
}

